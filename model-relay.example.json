{
  "format": 2,
  "port": 8950,
  "failover": {
    "enabled": true,
    "chain": ["backup"],
    "cooldownMs": 600000
  },
  "providers": {
    "backup": {
      "preset": "deepseek",
      "token": "env:BACKUP_API_KEY",
      "model": "your-model-id"
    },
    "local": {
      "baseUrl": "http://127.0.0.1:4000",
      "token": "env:LOCAL_GATEWAY_TOKEN",
      "model": "your-local-model-id",
      "matchModels": ["^local"],
      "stripCacheControl": true,
      "authHeader": "bearer",
      "launch": { "command": "my-gateway", "args": ["serve", "--port", "4000"] }
    }
  },
  "avatars": {
    "claude": { "image": "model-relay-avatars/claude.webp", "head": [471, 200, 340] },
    "backup": "model-relay-avatars/backup.webp"
  }
}
